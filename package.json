{
  "name": "sync-show",
  "version": "1.4.0-preview.21",
  "description": "Synchronized configurable presentation outputs for church services",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:linux": "electron . --no-sandbox",
    "dev": "electron . --dev",
    "dev:linux": "electron . --no-sandbox --dev",
    "check": "node scripts/check-js.js",
    "test": "node --test",
    "test:live-cue-navigation-electron": "node scripts/verify-live-cue-navigation-electron.js",
    "test:native-electron-rehearsal": "node scripts/verify-native-weekly-electron-rehearsal.js",
    "test:community-service-electron": "node scripts/verify-community-service-electron.js",
    "test:operational-planning-electron": "node scripts/verify-operational-planning-electron.js",
    "ci": "npm run check && npm test",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:mac:adhoc": "electron-builder --mac --config.mac.identity=-",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "build:configure-google-drive": "node scripts/google-drive-build-config.js inject",
    "build:verify-google-drive": "node scripts/google-drive-build-config.js verify",
    "build:clean-google-drive": "node scripts/google-drive-build-config.js clean",
    "build:verify-pdf-engine": "node scripts/verify-packaged-pdf-engine.js",
    "build:verify-sharp": "node scripts/verify-packaged-sharp.js",
    "build:verify-package-smoke": "node scripts/verify-package-smoke.js",
    "build:verify-service-core": "node scripts/verify-packaged-service-core.js",
    "build:verify-app-launch": "node scripts/verify-packaged-app-launch.js",
    "build:verify-remote-lan": "node scripts/verify-packaged-remote-lan.js",
    "build:verify-release-legal": "node scripts/verify-release-legal.js",
    "generate-icon": "node scripts/generate-icon.js"
  },
  "keywords": [
    "presentation",
    "church",
    "bilingual",
    "powerpoint",
    "dual-screen"
  ],
  "author": {
    "name": "Oles Maiovskyi",
    "email": "oles@mayo.onl"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "tslib": "^2.8.1"
  },
  "dependencies": {
    "@syncshow/service-core": "file:packages/service-core",
    "@napi-rs/canvas": "1.0.3",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.2.108",
    "pptxtojson": "^1.12.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.3"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-win32-x64": "0.35.3"
  },
  "build": {
    "appId": "com.church.syncshow",
    "productName": "SyncShow",
    "buildVersion": "140021",
    "beforePack": "scripts/beforePack.js",
    "afterPack": "scripts/afterPack.js",
    "copyright": "Copyright © 2026 Church Media Team",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "assets/icon-512.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "SyncShow uses your trusted local network so a phone you pair can control the active presentation.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SyncShow",
      "license": "LICENSE.txt"
    },
    "dmg": {
      "title": "SyncShow ${version}",
      "icon": "assets/icon-512.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "LICENSE.txt",
      "src/**/*",
      "!src/renderer/test-thumbnails.html",
      "packages/service-core/**/*",
      "assets/**/*",
      "!assets/google-drive-config.json",
      "node_modules/**/*",
      "!node_modules/@img/sharp-wasm32/**"
    ],
    "asarUnpack": [
      "assets/fonts/**",
      "node_modules/@napi-rs/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "asar": true,
    "compression": "normal"
  }
}
